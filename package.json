{
  "name": "jeevikasetu",
  "version": "1.0.0",
  "description": "Voice-First Flood Livelihood Recovery and Administrative Coordination Platform for Bihar (HSC 2027)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --workspace=server run test",
    "test": "npm run test:server",
    "seed": "npm --workspace=server run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "bihar-floods",
    "livelihood-recovery",
    "voice-first",
    "hsc-2027",
    "viksit-bharat",
    "disaster-management"
  ],
  "author": "JeevikaSetu Team - Hack for Social Cause 2027",
  "license": "MIT"
}
